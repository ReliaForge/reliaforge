{
  "name": "reliaforge-web",
  "version": "1.0.0",
  "private": true,
  "description": "Product website for ReliaForge, the plugin-based operations console for SRE and homelab teams.",
  "license": "MIT",
  "author": "Sajo Luo",
  "homepage": "https://reliaforge.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReliaForge/reliaforge.git"
  },
  "bugs": {
    "url": "https://github.com/ReliaForge/reliaforge/issues"
  },
  "engines": {
    "node": ">=22.12",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "node --test scripts/check-open-source-hygiene.test.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "check:hygiene": "node scripts/check-open-source-hygiene.mjs ."
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "17.14.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "^6.4.1"
  },
  "overrides": {
    "picomatch": "npm:@ryotsu/picomatch@4.0.7-a"
  }
}
